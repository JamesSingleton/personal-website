{
  "name": "personal-website",
  "version": "1.0.0",
  "private": true,
  "description": "James Singleton's personal website: Next.js 16 + Sanity Studio 6 monorepo, based on Roboto Studio's turbo-start-sanity.",
  "license": "MIT",
  "author": "James Singleton",
  "scripts": {
    "build": "turbo run build",
    "build:studio": "turbo run build --filter=studio",
    "build:web": "turbo run build --filter=web",
    "dev": "turbo run dev",
    "dev:studio": "turbo run dev --filter=studio",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "type": "turbo run type",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  }
}
